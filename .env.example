# Hangi LLM sağlayıcısını kullanacağınızı seçin: "groq" (önerilir) veya "gemini"
LLM_PROVIDER=groq

# https://console.groq.com/keys adresinden ücretsiz alınır
GROQ_API_KEY=

# https://aistudio.google.com/apikey adresinden ücretsiz alınır (LLM_PROVIDER=gemini ise gerekli)
GEMINI_API_KEY=

# ÖNEMLİ: Bu değişkenlerin önünde artık VITE_ öneki YOK.
# Çünkü bu anahtarlar artık tarayıcıya hiç gönderilmiyor, sadece
# sunucu tarafında (api/parse.js ve vite.config.js dev proxy) kullanılıyor.
