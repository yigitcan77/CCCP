# Hangi LLM sağlayıcısını kullanacağınızı seçin: "groq" (önerilir, hızlı ve free) veya "gemini"
VITE_LLM_PROVIDER=groq

# https://console.groq.com/keys adresinden ücretsiz alınır
VITE_GROQ_API_KEY=

# https://aistudio.google.com/apikey adresinden ücretsiz alınır (VITE_LLM_PROVIDER=gemini ise gerekli)
VITE_GEMINI_API_KEY=
